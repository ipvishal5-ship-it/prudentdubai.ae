# Private server-only values. Never prefix these with NEXT_PUBLIC_.
ADMIN_PASSWORD=use-a-long-unique-password
ADMIN_SESSION_SECRET=generate-at-least-32-random-characters

# HTTPS endpoint for your approved CRM, automation or email intake service.
LEAD_WEBHOOK_URL=https://example.com/secure-lead-endpoint
LEAD_WEBHOOK_SECRET=optional-bearer-secret

# OPTION A: Hostinger Company Email (Direct SMTP - Recommended)
# In Hostinger, vikas@prudentdubai.com and info@prudentdubai.com share the same mailbox (email alias / forwarder).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=vikas@prudentdubai.com
SMTP_PASS=your_hostinger_email_password
LEAD_NOTIFICATION_EMAIL=info@prudentdubai.com

# OPTION B: Resend API (Alternative fallback)
# RESEND_API_KEY=re_123456789
# RESEND_FROM_EMAIL=PrudentDubai Leads <onboarding@resend.dev>

# Keep disabled until article and area datasets have complete Arabic translations.
NEXT_PUBLIC_ENABLE_ARABIC=false
